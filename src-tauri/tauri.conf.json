{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkSpace",
  "version": "1.29.0",
  "identifier": "com.atott.markspace",
  "build": {
    "beforeDevCommand": "npm run sidecar:stage:if-needed && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sidecar:stage:release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline' blob:; img-src 'self' asset: http://asset.localhost blob: data: https:; font-src 'self' data: blob:; media-src 'self' asset: http://asset.localhost blob: data:; worker-src 'self' blob:; frame-src 'self'; child-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:*",
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "**/*"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": [
      "binaries/markspace-embeddings"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDRTgwQjFGNkUwNTY5N0YKUldSL2FRVnVId3ZvSEI2T3dZUndtc09zZEV1Q0NDczRlMXd6QnM3eWRTQ0ZUa3gvRnZVaXpCdmgK",
      "endpoints": [
        "https://github.com/antonzvonovge/MarkSpace/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
