{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkSpace",
  "version": "0.1.0",
  "identifier": "com.atott.markspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDRTgwQjFGNkUwNTY5N0YKUldSL2FRVnVId3ZvSEI2T3dZUndtc09zZEV1Q0NDczRlMXd6QnM3eWRTQ0ZUa3gvRnZVaXpCdmgK",
      "endpoints": [
        "https://github.com/antonzvonovge/MarkSpace/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
